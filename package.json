{
  "name": "lost-found-uex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --env-file=.env --watch server/src/index.js",
    "dev:client": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "start": "node --env-file=.env server/src/index.js",
    "db:migrate": "node --env-file=.env server/scripts/migrate.js",
    "db:seed-dev": "node --env-file=.env server/scripts/seed-dev.js",
    "test": "vitest run",
    "test:db": "node --env-file=.env --test server/tests/postgres.test.js server/tests/recovery-tokens.postgres.test.js server/tests/recovery.postgres.test.js server/tests/hallazgos.postgres.test.js server/tests/hallazgos-storage.postgres.test.js server/tests/hallazgos-busqueda.postgres.test.js server/tests/mis-hallazgos.postgres.test.js server/tests/avisos.postgres.test.js",
    "test:monolith": "npm run build && node --env-file=.env --test server/tests/monolith.test.js"
  },
  "dependencies": {
    "argon2": "^0.45.2",
    "connect-pg-simple": "^10.0.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "concurrently": "^10.0.7",
    "jsdom": "^26.1.0",
    "supertest": "^7.3.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
